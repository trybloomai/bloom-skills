<mxfile host="app.diagrams.net" modified="2026-10-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="image-memory-eviction" name="How image memory survives eviction">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="1000" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;How the model ‘remembers’ an image after its pixels leave context&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="60" y="28" width="1320" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="The API is stateless: every model call is rebuilt by replaying selected conversation messages." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#6B7280;" vertex="1" parent="1">
          <mxGeometry x="62" y="78" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="timeline" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="125" width="1510" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="timelineLabel" value="WHAT IS REPLAYED OVER TIME" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#7C3AED;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="300" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" source="s2" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" source="s3" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9CA3AF;strokeWidth=2;endArrow=classic;endFill=1;" edge="1" source="s4" target="s5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="&lt;font style=&quot;font-size:13px;color:#2563EB&quot;&gt;&lt;b&gt;VIEW&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Image pixels enter&lt;br&gt;the transcript&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;view_files returns the image bytes plus path and type.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=16;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="250" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="&lt;font style=&quot;font-size:13px;color:#2563EB&quot;&gt;&lt;b&gt;NEXT 3 MODEL CALLS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Pixels are still replayed&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;The model can inspect the source again while it reasons and uses tools.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=16;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="370" y="190" width="250" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;font style=&quot;font-size:13px;color:#059669&quot;&gt;&lt;b&gt;ASSISTANT MESSAGE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The model writes observations&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;Example: “dark terminal UI, acid-green accent, serif wordmark.”&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=16;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="670" y="190" width="250" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="&lt;font style=&quot;font-size:13px;color:#6B7280&quot;&gt;&lt;b&gt;4TH SUBSEQUENT CALL&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Old pixels are evicted&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;They become neutral metadata: path, media type, and byte length.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=16;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="970" y="190" width="250" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="&lt;font style=&quot;font-size:13px;color:#059669&quot;&gt;&lt;b&gt;LATER AUTHORING&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Written observations remain&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;Those earlier assistant messages are replayed, so the model can use them without pixels.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=2;align=left;verticalAlign=top;spacing=16;fontSize=16;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="1270" y="190" width="250" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="beforePanel" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFDBFE;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="45" y="520" width="555" height="315" as="geometry"/>
        </mxCell>
        <mxCell id="beforeTitle" value="&lt;b&gt;REQUEST 3 — pixels still present&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="70" y="540" width="420" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="beforePixels" value="&lt;b&gt;Image file part&lt;/b&gt;&lt;br&gt;[1.4 MB of pixels]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#60A5FA;align=left;spacingLeft=14;fontSize=15;fontColor=#1E3A8A;" vertex="1" parent="1">
          <mxGeometry x="75" y="590" width="500" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="beforeNotes" value="&lt;b&gt;Assistant observations&lt;/b&gt;&lt;br&gt;“dark terminal UI, acid-green accent…”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#34D399;align=left;spacingLeft=14;fontSize=15;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="75" y="665" width="500" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="beforeHistory" value="Tool calls + user messages + provider metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;align=left;spacingLeft=14;fontSize=14;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="75" y="740" width="500" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="eviction" value="&lt;b&gt;After 3 completed&lt;br&gt;model calls&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;evict pixels&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=15;fontColor=#5B21B6;" vertex="1" parent="1">
          <mxGeometry x="650" y="610" width="155" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="evictionEdge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B5CF6;strokeWidth=3;endArrow=classic;endFill=1;" edge="1" source="beforePanel" target="eviction" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="evictionEdge2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B5CF6;strokeWidth=3;endArrow=classic;endFill=1;" edge="1" source="eviction" target="afterPanel" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="afterPanel" value="" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="855" y="520" width="700" height="315" as="geometry"/>
        </mxCell>
        <mxCell id="afterTitle" value="&lt;b&gt;REQUEST 4+ — pixels gone, meaning retained&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="880" y="540" width="570" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="afterMeta" value="&lt;b&gt;Neutral image reference&lt;/b&gt;&lt;br&gt;{ path, mediaType, byteLength }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;align=left;spacingLeft=14;fontSize=15;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="885" y="590" width="640" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="afterNotes" value="&lt;b&gt;Assistant observations — unchanged&lt;/b&gt;&lt;br&gt;“dark terminal UI, acid-green accent…”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#34D399;strokeWidth=2;align=left;spacingLeft=14;fontSize=15;fontColor=#064E3B;" vertex="1" parent="1">
          <mxGeometry x="885" y="665" width="640" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="afterSignature" value="Gemini thought signature may also be replayed — opaque continuity, not a trustworthy visual summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;dashed=1;align=left;spacingLeft=14;fontSize=13;fontColor=#5B21B6;" vertex="1" parent="1">
          <mxGeometry x="885" y="740" width="640" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="caveat" value="&lt;b&gt;Important failure mode:&lt;/b&gt; If the model never writes a complete visual summary, the missing details are genuinely lost after eviction. Three turns create an opportunity to summarize; they are not a guarantee." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=18;fontSize=16;fontColor=#78350F;" vertex="1" parent="1">
          <mxGeometry x="45" y="860" width="960" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="notMemory" value="&lt;b&gt;NOT the memory mechanism&lt;/b&gt;&lt;br&gt;Prompt cache → only cost/latency reuse&lt;br&gt;Neutral metadata → identity, not visual meaning&lt;br&gt;Hidden session → none; the API call is stateless" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=18;fontSize=15;fontColor=#7F1D1D;" vertex="1" parent="1">
          <mxGeometry x="1035" y="860" width="520" height="95" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
