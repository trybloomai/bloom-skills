        <mxCell id="evidence" value="&lt;b&gt;Key distinction:&lt;/b&gt;&amp;nbsp;&amp;nbsp; sandbox storage alone does not enlarge the prompt &amp;nbsp;•&amp;nbsp; only view_files / execute returns cross into model context &amp;nbsp;•&amp;nbsp; queue ≈ 1s" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#D1D5DB;fontColor=#374151;fontSize=15;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
