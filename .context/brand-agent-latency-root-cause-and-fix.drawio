        <mxCell id="title" value="&lt;b&gt;Brand Agent latency: root cause → proposed fix&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontColor=#111827;" vertex="1" parent="1">
