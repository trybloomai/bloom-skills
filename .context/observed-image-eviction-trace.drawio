        <mxCell id="q1label" value="REQUEST 3 · WHILE PIXELS WERE PRESENT" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="75" y="455" width="500" height="24" as="geometry"/></mxCell>
        <mxCell id="q1" value="“moodboard-01: A heart-shaped hand gesture…”&lt;br&gt;“moodboard-02: A simple serif-font wordmark ‘David™’…”&lt;br&gt;…then describes moodboards 03–08." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;align=left;verticalAlign=middle;spacing=16;fontSize=15;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="70" y="490" width="660" height="125" as="geometry"/></mxCell>
        <mxCell id="quoteArrow" value="same descriptions&lt;br&gt;survive eviction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B5CF6;strokeWidth=3;endArrow=classic;endFill=1;fontSize=13;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;" edge="1" source="q1" target="q2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q2label" value="REQUEST 9 · THREE REQUESTS AFTER EVICTION" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#059669;" vertex="1" parent="1"><mxGeometry x="870" y="455" width="550" height="24" as="geometry"/></mxCell>
        <mxCell id="q2" value="“Let’s refresh our memory of what each image looked like.”&lt;br&gt;&lt;br&gt;It then recites the heart-hands image, David™ wordmark, white square, blue chart, Koncilio, Madewell.ai, ‘25, and Zapier." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;align=left;verticalAlign=middle;spacing=16;fontSize=15;fontColor=#064E3B;" vertex="1" parent="1"><mxGeometry x="865" y="490" width="660" height="125" as="geometry"/></mxCell>
        <mxCell id="warning" value="&lt;b&gt;But this does not establish reliable visual memory.&lt;/b&gt;&lt;br&gt;&lt;br&gt;A separate passing run (610333) omitted both colors and typography relative to baseline. Another run produced only a broad synthesis. The model remembered enough to finish, not necessarily enough to preserve every important detail." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=2;align=left;verticalAlign=middle;spacing=18;fontSize=16;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="45" y="680" width="720" height="165" as="geometry"/></mxCell>
        <mxCell id="decision" value="&lt;b&gt;Safe conclusion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Do not depend on spontaneous free-form summarization. Evict only after a structured visual-memory checkpoint is present and validated; otherwise retain or reopen the original image for detail-sensitive authoring." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;align=left;verticalAlign=middle;spacing=18;fontSize=16;fontColor=#78350F;" vertex="1" parent="1"><mxGeometry x="795" y="680" width="760" height="165" as="geometry"/></mxCell>
